{
  "name": "nemedi-clinic",
  "private": true,
  "description": "Raíz del monorepo: solo tests end-to-end que actúan como gate de push. Cada app se construye sola (apps/api, apps/web).",
  "scripts": {
    "test": "playwright test --project=api",
    "test:report": "playwright show-report",
    "prepare": "git config core.hooksPath .githooks",
    "test:ui": "playwright test --project=admin",
    "test:all": "playwright test",
    "guide:pdf": "node docs/manual/build-pdf.mjs",
    "test:mobile": "playwright test --project=mobile"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0"
  }
}
