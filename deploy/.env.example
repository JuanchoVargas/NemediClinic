# Copia este archivo a deploy/.env y completa los valores. deploy/.env NO se versiona.

# Dominios públicos que atiende Caddy, separados por coma: uno por canal (marca blanca).
# Cada uno debe coincidir con el "Dominio" del canal en /platform → Canales y tener su DNS
# apuntando al VPS. Con dominios reales Caddy emite HTTPS solo (Let's Encrypt).
# Para probar en local sin certificados usa: http://localhost
DOMAIN=app.nemediclinic.com, app.infotex.co

# Nombre de respaldo del frontend mientras carga la marca del canal
APP_NAME=NemediClinic

# Primer administrador de PLATAFORMA (crea tenants, canales, oportunidades y ve la liquidación).
# Solo se usa si aún no existe ninguno; después cambia la clave desde la base o rota estas variables.
# La contraseña debe tener al menos 10 caracteres.
Platform__AdminEmail=plataforma@ejemplo.com
Platform__AdminPassword=

# SQL Server. Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=CambiaEstaClave_2026!
# Express (gratis, hasta 10 GB por base) o Developer (solo para pruebas)
MSSQL_PID=Express

# Cadena de conexión del API. Debe llevar la MISMA contraseña de arriba (Compose no
# expande variables dentro de .env). El API crea la base y aplica migraciones al arrancar.
ConnectionStrings__DefaultConnection=Server=mssql,1433;Database=NemediClinic;User Id=sa;Password=CambiaEstaClave_2026!;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true

# Clave de firma de los JWT. Mínimo 32 caracteres, aleatoria. Genera una con:
#   openssl rand -base64 48
# El API se niega a arrancar en Production si está vacía o es la de desarrollo.
Jwt__Secret=
Jwt__ExpirationMinutes=60

# Correo (opcional). Si Smtp__Host está vacío no se envía nada y todo sigue funcionando:
# las claves temporales siempre se muestran en pantalla a quien las genera.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=
Smtp__EnableSsl=true

# Orígenes permitidos para CORS, separados por coma. El frontend llama al API en su mismo
# origen, así que basta con los mismos dominios de DOMAIN con https://.
CORS_ORIGINS=https://app.nemediclinic.com,https://app.infotex.co
