# API base URL (sin trailing slash). "/" = mismo origen (producción detrás de Caddy).
VITE_API_URL=http://localhost:5055

# Nombre de respaldo mientras carga la marca del canal (GET /api/v1/branding)
VITE_APP_NAME=NemediClinic

